# 1. API Keys & Authentication Credentials
GOOGLE_API_KEY=your_gemini_api_key_here
JWT_SECRET=replace_this_with_a_secure_long_secret_key_for_production
DEMO_USER_EMAIL=user@example.com
DEMO_USER_PASSWORD=password123

# 2. Database Configurations
# Local: sqlite:///./database/database.db
# Docker: sqlite:////app/data/database.db
# Prod: postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///./database/database.db

# 3. Microservice Networking Hooks
API_BASE_URL=http://backend:8000/api
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
